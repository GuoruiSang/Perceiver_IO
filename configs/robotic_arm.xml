<mujoco>
    <option gravity="0 0 -9.81" integrator="RK4"/>
    <worldbody>
        <body name="robotic_arm">
            <joint name="joint1" type="ball" damping="1.0"/>
            <geom name="link1" type="capsule" fromto="0 0 0 1 0 0" size="0.05" mass="1" rgba="1 0 0 1"/>
            <!-- A child body will move relative to its parent body. 
            When we set the position of link2_body to the endpoint of link1, 
            it means that link2 is attached to link1 -->
            <body name="link2_body" pos="1 0 0">
                <joint name="joint2" type="ball" damping="1.0"/>
                <geom name="link2" type="capsule" fromto="0 0 0 1 0 0" size="0.05" mass="1" rgba="0 1 0 1"/>
                <!-- <body name="link3_body" pos="1 0 0">
                    <joint name="joint3" type="ball"/>
                    <geom name="link3" type="capsule" fromto="0 0 0 1 0 0" size="0.05" mass="1" rgba="0 0 1 1"/>
                </body> -->
            </body>
        </body>
    </worldbody>
    <actuator>
        <!-- Ball joint 1: 3 motors for x, y, z rotational axes -->
        <motor joint="joint1" name="motor1_x" gear="1 0 0" ctrlrange="-5 5"/>
        <motor joint="joint1" name="motor1_y" gear="0 1 0" ctrlrange="-5 5"/>
        <motor joint="joint1" name="motor1_z" gear="0 0 1" ctrlrange="-5 5"/>
        
        <!-- Ball joint 2: 3 motors for x, y, z rotational axes -->
        <motor joint="joint2" name="motor2_x" gear="1 0 0" ctrlrange="-5 5"/>
        <motor joint="joint2" name="motor2_y" gear="0 1 0" ctrlrange="-5 5"/>
        <motor joint="joint2" name="motor2_z" gear="0 0 1" ctrlrange="-5 5"/>
    </actuator>
</mujoco>